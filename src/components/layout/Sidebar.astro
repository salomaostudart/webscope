---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: 'Scanner', href: '/' },
  { label: 'History', href: '/history' },
  { label: 'About', href: '/about' },
];

const reportItems: NavItem[] = [
  { label: 'Overview', href: '/report' },
  { label: 'Performance', href: '/report/performance' },
  { label: 'SEO', href: '/report/seo' },
  { label: 'Accessibility', href: '/report/accessibility' },
  { label: 'Content', href: '/report/content' },
  { label: 'Branding', href: '/report/branding' },
  { label: 'Security', href: '/report/security' },
];

const isReportPage = currentPath.startsWith('/report');
---

<aside class="sidebar" id="sidebar" aria-label="Main navigation">
  <div class="sidebar-header">
    <a href="/" class="logo" aria-label="WebScope home">
      <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        <line x1="11" y1="8" x2="11" y2="14"/>
        <line x1="8" y1="11" x2="14" y2="11"/>
      </svg>
      <span class="logo-text">WebScope</span>
    </a>
  </div>

  <nav class="sidebar-nav">
    <ul class="nav-list" role="list">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', { active: currentPath === item.href }]}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            <span class="nav-link-text">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>

    {isReportPage && (
      <>
        <div class="nav-divider" role="separator"></div>
        <p class="nav-section-title">Report</p>
        <ul class="nav-list" role="list">
          {reportItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: currentPath === item.href || (item.href === '/report' && currentPath === '/report/') }]}
              >
                <span class="nav-link-text">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </nav>

  <div class="sidebar-footer">
    <a href="/login" class="nav-link login-link">
      <span class="nav-link-text">Login</span>
    </a>
  </div>
</aside>

<div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100dvh;
    background: var(--surface-1);
    border-right: 1px solid var(--border-default);
    display: flex;
    flex-direction: column;
    z-index: 100;
    transition: transform var(--transition-base);
    /* Safe area for notch on landscape iPhone */
    padding-left: env(safe-area-inset-left, 0px);
  }

  .sidebar-header {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-default);
    flex-shrink: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-primary);
    text-decoration: none;
  }
  .logo:hover { color: var(--accent-primary); }

  .logo-icon {
    width: 24px;
    height: 24px;
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4) 0;
    -webkit-overflow-scrolling: touch;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    padding: var(--space-3) var(--space-5);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    transition: all var(--transition-fast);
    border-left: 3px solid transparent;
    min-height: 44px;
  }
  .nav-link:hover {
    color: var(--text-primary);
    background: var(--surface-2);
  }
  .nav-link.active {
    color: var(--accent-primary);
    border-left-color: var(--accent-primary);
    background: rgba(129, 140, 248, 0.08);
  }

  .nav-divider {
    height: 1px;
    background: var(--border-default);
    margin: var(--space-3) var(--space-5);
  }

  .nav-section-title {
    padding: var(--space-1) var(--space-5);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sidebar-footer {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border-default);
    flex-shrink: 0;
    /* Safe area for bottom gesture bar */
    padding-bottom: max(var(--space-3), env(safe-area-inset-bottom, 0px));
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 99;
    -webkit-tap-highlight-color: transparent;
  }

  /* Tablet + Mobile: sidebar as overlay */
  @media (max-width: 1024px) {
    .sidebar {
      transform: translateX(-100%);
      box-shadow: var(--shadow-lg);
    }
    .sidebar:global(.open) {
      transform: translateX(0);
    }
    .sidebar-overlay:global(.open) {
      display: block;
    }
  }

  /* Prevent body scroll when sidebar is open on mobile */
  :global(body.sidebar-open) {
    overflow: hidden;
  }
</style>
