---
import DrillDownLayout from '../../layouts/DrillDownLayout.astro';
---

<DrillDownLayout analyzerName="accessibility" displayName="Accessibility">
  <div id="a11y-data"></div>
</DrillDownLayout>

<style>
  .a11y-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px,100%), 1fr)); gap: var(--space-3); margin-bottom: var(--space-6); }
  .a11y-stat { padding: var(--space-4); background: var(--surface-2); border: 1px solid var(--border-default); border-radius: var(--radius-md); text-align: center; }
  .a11y-stat-value { font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 600; }
  .a11y-stat-label { font-size: var(--text-xs); color: var(--text-muted); text-transform: uppercase; margin-top: var(--space-1); }
  .landmarks-section { margin-bottom: var(--space-6); }
  .landmarks-section h3 { font-size: var(--text-base); color: var(--text-primary); margin-bottom: var(--space-3); }
  .landmark-tag { display: inline-block; padding: 4px 12px; border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 500; margin: 2px; }
  .landmark-present { background: rgba(34,197,94,0.15); color: var(--grade-a); border: 1px solid rgba(34,197,94,0.3); }
  .landmark-missing { background: rgba(239,68,68,0.15); color: var(--grade-f); border: 1px solid rgba(239,68,68,0.3); }
</style>

<script>
  import { escapeHtml } from '../../utils/sanitize';

  window.addEventListener('analyzer-data-ready', () => {
    const d = (window as any).__analyzerData;
    if (!d) return;
    const container = document.getElementById('a11y-data')!;

    let html = '<div class="a11y-grid">';
    html += `<div class="a11y-stat"><div class="a11y-stat-value" style="color:var(--text-primary)">${d.lighthouseScore || 'N/A'}</div><div class="a11y-stat-label">Lighthouse Score</div></div>`;
    html += `<div class="a11y-stat"><div class="a11y-stat-value" style="color:var(--grade-f)">${d.violations?.length || 0}</div><div class="a11y-stat-label">Violations</div></div>`;
    html += `<div class="a11y-stat"><div class="a11y-stat-value" style="color:var(--grade-a)">${d.passes || 0}</div><div class="a11y-stat-label">Passed</div></div>`;
    html += `<div class="a11y-stat"><div class="a11y-stat-value" style="color:var(--grade-c)">${d.contrastIssues || 0}</div><div class="a11y-stat-label">Contrast Issues</div></div>`;
    html += `<div class="a11y-stat"><div class="a11y-stat-value">${d.imagesWithoutAlt || 0}</div><div class="a11y-stat-label">Images No Alt</div></div>`;
    html += `<div class="a11y-stat"><div class="a11y-stat-value">${d.formsWithoutLabels || 0}</div><div class="a11y-stat-label">Forms No Label</div></div>`;
    html += '</div>';

    // Landmarks
    html += '<div class="landmarks-section"><h3>HTML Landmarks</h3>';
    if (d.landmarksPresent?.length) {
      d.landmarksPresent.forEach((l: string) => { html += `<span class="landmark-tag landmark-present">&lt;${escapeHtml(l)}&gt;</span>`; });
    }
    if (d.landmarksMissing?.length) {
      d.landmarksMissing.forEach((l: string) => { html += `<span class="landmark-tag landmark-missing">&lt;${escapeHtml(l)}&gt; missing</span>`; });
    }
    html += `<p style="margin-top:var(--space-2);font-size:var(--text-xs);color:var(--text-muted)">Language: ${d.languageSet ? 'Set' : 'Missing'}</p>`;
    html += '</div>';

    container.innerHTML = html;
  });
</script>
