---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="History" description="Browse past WebScope audits.">
  <div class="history-page">
    <header class="history-header">
      <h1>Audit History</h1>
      <a href="/" class="new-audit-link">Run new audit</a>
    </header>

    <div id="history-content">
      <p class="loading-msg">Loading audits...</p>
    </div>
  </div>
</BaseLayout>

<style>
  .history-page {
    max-width: 900px;
  }

  .history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
    gap: var(--space-4);
  }

  .history-header h1 {
    color: var(--accent-primary);
    margin: 0;
  }

  .new-audit-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-primary);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }
  .new-audit-link:hover {
    background: rgba(129, 140, 248, 0.08);
  }

  .loading-msg {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .empty-state {
    padding: var(--space-10) var(--space-6);
    background: var(--surface-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    text-align: center;
    color: var(--text-secondary);
  }
  .empty-state p {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }

  .audit-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--surface-2);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  thead th {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--border-default);
    white-space: nowrap;
  }

  tbody td {
    padding: var(--space-3) var(--space-4);
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-default);
    vertical-align: middle;
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody tr:hover td {
    background: var(--surface-3);
  }

  .td-url {
    max-width: 280px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-primary);
  }

  .td-score {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .grade-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 2px solid;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .grade-A { color: var(--grade-a); border-color: var(--grade-a); }
  .grade-B { color: var(--grade-b); border-color: var(--grade-b); }
  .grade-C { color: var(--grade-c); border-color: var(--grade-c); }
  .grade-D { color: var(--grade-d); border-color: var(--grade-d); }
  .grade-F { color: var(--grade-f); border-color: var(--grade-f); }

  .report-link {
    font-size: var(--text-xs);
    color: var(--accent-primary);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: all var(--transition-fast);
  }
  .report-link:hover {
    background: rgba(129, 140, 248, 0.08);
  }

  .error-msg {
    color: var(--accent-danger, var(--text-muted));
    font-size: var(--text-sm);
    padding: var(--space-4);
    background: var(--surface-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
  }
</style>

<script>
  import { listAudits } from '../lib/db';
  import type { AuditSummary } from '../lib/db';
  import { escapeHtml } from '../utils/sanitize';

  const container = document.getElementById('history-content');
  if (!container) throw new Error('history-content not found');

  function formatDate(iso: string): string {
    try {
      return new Date(iso).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    } catch {
      return iso;
    }
  }

  function truncateUrl(url: string, max = 50): string {
    try {
      const u = new URL(url);
      const display = u.hostname + u.pathname;
      return display.length > max ? display.slice(0, max) + '…' : display;
    } catch {
      return url.length > max ? url.slice(0, max) + '…' : url;
    }
  }

  function renderEmpty(): string {
    return `
      <div class="empty-state">
        <p>No audits yet.</p>
        <a href="/" class="report-link">Run your first audit</a>
      </div>
    `;
  }

  function renderTable(audits: AuditSummary[]): string {
    const rows = audits.map((a) => {
      const shareUrl = `/report?id=${encodeURIComponent(a.id)}`;
      const gradeClass = `grade-${escapeHtml(a.overall_grade)}`;
      return `
        <tr>
          <td class="td-url" title="${escapeHtml(a.url)}">${escapeHtml(truncateUrl(a.url))}</td>
          <td>${escapeHtml(formatDate(a.created_at))}</td>
          <td class="td-score">${escapeHtml(String(a.overall_score))}</td>
          <td><span class="grade-badge ${gradeClass}">${escapeHtml(a.overall_grade)}</span></td>
          <td><a href="${shareUrl}" class="report-link">View</a></td>
        </tr>
      `;
    }).join('');

    return `
      <div class="audit-table-wrapper">
        <table>
          <thead>
            <tr>
              <th>URL</th>
              <th>Date</th>
              <th>Score</th>
              <th>Grade</th>
              <th></th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
    `;
  }

  try {
    const audits = await listAudits();
    container.innerHTML = audits.length === 0 ? renderEmpty() : renderTable(audits);
  } catch (err) {
    if (import.meta.env?.DEV) console.error('Failed to load audits:', err);
    container.innerHTML = '<p class="error-msg">Failed to load audit history.</p>';
  }
</script>
