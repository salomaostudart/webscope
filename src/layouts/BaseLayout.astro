---
import Sidebar from '../components/layout/Sidebar.astro';
import ThemeToggle from '../components/layout/ThemeToggle.astro';
import FeedbackButton from '../components/ui/FeedbackButton.astro';
import CommandPalette from '../components/ui/CommandPalette.astro';
import Toast from '../components/ui/Toast.astro';
import ConfirmDialog from '../components/ui/ConfirmDialog.astro';

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const { title, description = 'Analyze any website for performance, SEO, accessibility, content, branding, and security.', fullWidth = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title} — WebScope</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="manifest" href="/manifest.json">
  <link rel="sitemap" href="/sitemap-index.xml">
  <!-- Open Graph -->
  <meta property="og:title" content="WebScope — Website Intelligence Platform">
  <meta property="og:description" content="Analise automatizada de sites: performance, acessibilidade e SEO em um relatorio.">
  <meta property="og:image" content="/og-cover.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content="https://webscope.sal.dev.br/">
  <meta property="og:type" content="website">
  <!-- iOS PWA -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="theme-color" content="#0a0a0f">

  <!-- Theme initialization (prevent flash) -->
  <script is:inline>
    (() => {
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      // Update theme-color meta for light mode
      if (theme === 'light') {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', '#f1f5f9');
      }
    })();
  </script>
</head>
<body>
  <Sidebar currentPath={currentPath} />

  <div class:list={['main-wrapper', { 'full-width': fullWidth }]}>
    <!-- Topbar -->
    <header class="topbar">
      <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Toggle menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <div class="topbar-spacer"></div>
      <ThemeToggle />
    </header>

    <!-- Page content -->
    <main class="page-content">
      <slot />
    </main>
  </div>

  <FeedbackButton />
  <CommandPalette />
  <Toast />
  <ConfirmDialog />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/print.css';
</style>

<style>
  .main-wrapper {
    margin-left: var(--sidebar-width);
    min-height: 100dvh; /* dynamic viewport height — fixes iOS Safari */
    display: flex;
    flex-direction: column;
  }
  .main-wrapper.full-width {
    margin-left: 0;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    height: var(--topbar-height);
    padding: 0 var(--space-6);
    padding-right: max(var(--space-6), env(safe-area-inset-right, 0px));
    background: var(--surface-1);
    border-bottom: 1px solid var(--border-default);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .topbar-spacer { flex: 1; }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-height: 44px;
    min-width: 44px;
    background: transparent;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .menu-toggle:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }
  .menu-toggle svg { width: 18px; height: 18px; }

  .page-content {
    flex: 1;
    padding: clamp(var(--space-4), 3vw, var(--space-10)) clamp(var(--space-4), 4vw, var(--space-8));
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  /* Tablet: sidebar collapses, hamburger appears */
  @media (max-width: 1024px) {
    .main-wrapper {
      margin-left: 0;
    }
    .menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Mobile/tablet sidebar toggle
  const menuToggle = document.getElementById('menu-toggle');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');

  function toggleSidebar() {
    sidebar?.classList.toggle('open');
    overlay?.classList.toggle('open');
    document.body.classList.toggle('sidebar-open');
    menuToggle?.setAttribute('aria-expanded', sidebar?.classList.contains('open') ? 'true' : 'false');
  }

  function closeSidebar() {
    sidebar?.classList.remove('open');
    overlay?.classList.remove('open');
    document.body.classList.remove('sidebar-open');
  }

  menuToggle?.addEventListener('click', toggleSidebar);
  overlay?.addEventListener('click', closeSidebar);

  // Close sidebar on navigation (for SPA-like behavior)
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', closeSidebar);
  });

  // Close sidebar on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSidebar();
  });
</script>
