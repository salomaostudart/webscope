# WebScope — Environment Variables
# Copy this file to .env and fill in values.

# Cloudflare Worker URL (proxy)
PUBLIC_WORKER_URL=https://webscope-api.salomaomstudart.workers.dev

# Cloudflare Account ID (for wrangler deploys)
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# PageSpeed Insights API Key (optional — increases rate limit from 25k/day)
# PSI_API_KEY=

# D1, Workers AI, KV are configured via wrangler.toml bindings (not env vars)
