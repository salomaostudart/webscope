# WebScope — Environment Variables
# Copy this file to .env and fill in values.

# Supabase (Auth + DB)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Claude API (for AI Suggestions — Edge Function only, not client-side)
CLAUDE_API_KEY=

# Cloudflare Worker URL (proxy)
PUBLIC_WORKER_URL=

# PageSpeed Insights API Key (optional — increases rate limit from 25k/day)
PSI_API_KEY=
