{
  "name": "webscope",
  "description": "Website intelligence platform — analyze any URL for performance, SEO, accessibility, content, branding, and security",
  "type": "module",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/salomaostudart/webscope"
  },
  "homepage": "https://webscope.sal.dev.br",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/",
    "format": "prettier --write src/ tests/",
    "type-check": "astro check",
    "ci": "astro check && vitest run && astro build",
    "deploy": "npm run ci && npx wrangler pages deploy dist --project-name webscope --branch main"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "astro": "^6.1.5",
    "echarts": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
